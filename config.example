{
  "schedule": {
    "time": "00:00",
    "timezone": "Asia/Ho_Chi_Minh",
    "run_on_start": false
  },
  "cookie_file": "cookies.json",
  "tiktok": {
    "headless": false,
    "user_data_dir_linux": "~/chrome-debug",
    "user_data_dir_macos": "~/Library/Application Support/chrome-debug",
    "user_data_dir_windows": "~\\AppData\\Local\\chrome-debug",
    "message_delay_seconds": [8, 18],
    "navigation_timeout_ms": 60000,
    "action_timeout_ms": 10000,
    "content_ready_timeout_ms": 45000,
    "dm_readiness_timeout_ms": 45000,
    "dm_load_attempts": 2,
    "probe_timeout_ms": 750,
    "low_memory_mode": false,
    "low_memory_stabilization_seconds": 4.0,
    "persistent_context": true,
    "recipient_retries": 1,
    "message_format": "native_video_card",
    "allow_raw_url_fallback": false,
    "keep_page_on_pre_send_failure": false
  },
  "runtime": {
    "run_lock_stale_seconds": 21600
  },
  "recipients": [
    {
      "name": "Tên hiển thị",
      "username": "username_tiktok"
    }
  ],
  "videos": [
    "https://www.tiktok.com/@username/video/VIDEO_ID",
    "https://vt.tiktok.com/VIDEO_ID"
  ],
  "telegram": {
    "enabled": false,
    "bot_token": "PASTE_BOT_TOKEN_HERE",
    "chat_id": "PASTE_CHAT_ID_HERE",
    "commands_enabled": false
  },
  "daemon": {
    "service_backend": "process",
    "systemd_service": "daily-streak-daemon.service",
    "systemd_scope": "user"
  },
  "android": {
    "device_id": null,
    "adb_path": "adb"
  }
}

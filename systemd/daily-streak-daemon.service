[Unit]
Description=Daily Streak Tool - TikTok Scheduled Sender Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.config/daily-streak-tool
ExecStart=%h/.venvs/streak/bin/streak --config %h/.config/daily-streak-tool/config.json daemon
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
